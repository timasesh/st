# Run locally without Supabase only. Render should use Supabase with a persistent database.
# The JSON fallback stores private data under DATA_DIR; use persistent storage for it.
DATA_DIR=.data

# Required together when using Supabase. Keep the service key on the server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional first-time administrator bootstrap. Set a strong password before first startup.
ADMIN_BOOTSTRAP_USERNAME=timaadmin
ADMIN_BOOTSTRAP_PASSWORD=

# Optional 4-digit PIN for the protected admin data-cleanup screen.
ADMIN_CLEANUP_PIN=2545

# Required only for teacher-generated tests.
NVIDIA_API_KEY=
# Optional. Defaults to moonshotai/kimi-k3.
NVIDIA_MODEL=

PORT=3000
NODE_ENV=development
